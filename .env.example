# Copy to .env (or .env.local) and fill in. Never commit the real file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use the Session pooler connection string (IPv4), e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_MODEL_FAST=gemini-3.5-flash-lite
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: the bot's @username (without @) for the website's "Log in with Telegram" link.
# If empty, it is looked up once from TELEGRAM_BOT_TOKEN (getMe).
TELEGRAM_BOT_USERNAME=
CRON_SECRET=
ORG_DASHBOARD_ACCESS_CODE=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
