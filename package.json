    "@types/pg": "^8.23.1",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shapefile": "^0.6.4",
    "@vitest/coverage-v8": "^5.1.1",
    "adm-zip": "^0.6.1",
    "axe-core": "^4.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.65.1",
